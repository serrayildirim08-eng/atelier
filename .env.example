# Atelier — environment variables
# Copy this file to .env.local for development. Never commit .env.local.
# In production (Azure App Service / Container Apps), set these via the
# platform's configuration UI or Key Vault references — not via committed files.

# --- Anthropic API ---
# Claude Opus 4.7 — legal reasoning + drafting (firm voice)
ANTHROPIC_API_KEY=

# --- OpenAI API ---
# Top OpenAI model at wiring time — workflow orchestration + tool calls
OPENAI_API_KEY=

# --- Database ---
# Local dev default matches docker-compose.yml (postgres:atelier / db:atelier).
# Production: point at Azure Database for PostgreSQL Flexible Server with the
# `vector` extension enabled (Azure exposes pgvector as an allowlisted extension).
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier

# --- Langfuse audit log ---
# Self-hosted Langfuse v3 endpoint + project keys. Used by lib/audit.ts to
# record one generation observation per Anthropic call (detect/extract/
# draft/review). Leave blank to disable — lib/audit.ts is a silent no-op
# when these are missing. Required before real-client testing per the
# state-bar audit-log obligations (ABA Op. 512, NYSBA 2024 Task Force,
# CA Practical Guidance). Bring up with `docker compose up -d langfuse`
# once a Langfuse compose template is added (deferred follow-up).
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
