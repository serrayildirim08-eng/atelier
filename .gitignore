# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
!/build/icon.png
!/build/icon.svg

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# usage telemetry (lib/usage-log.ts append-only JSONL)
db/cost.jsonl

# per-PDF extraction cache (lib/pdf-cache.ts content-hash dedup)
db/pdf-cache/

# document-classifier-renamer alias map (per-matter sidecar — runtime state)
db/filename-aliases.json

# manual matter / document overrides (display names + doc_type overrides)
db/matter-overrides.json

# per-matter typedMemory snapshot (disk-backed cache for reload survival)
db/matter-snapshot/

# pre-generation approval flow (lib/preview-store.ts) — per-matter
# preview JSON sidecars + append-only attorney-approval audit log.
db/previews/
db/audit/

# doctrine RAG snapshot (built locally from manuals/ + ~/akalan-context/
# via `npm run rag:build`). Re-buildable; not version-controlled.
db/rag-index.json

# claude code session state — ignore everything in .claude/ except shared, checked-in tooling
.claude/*
!.claude/skills
!.claude/skills/**
!.claude/hooks
!.claude/hooks/**
!.claude/commands
!.claude/commands/**
!.claude/scripts
!.claude/scripts/**
!.claude/settings.json

# electron build output
dist-electron/
