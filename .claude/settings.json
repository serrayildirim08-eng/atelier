{
  "permissions": {
    "allow": [
      "Bash(npx tsc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.sh"
          }
        ]
      }
    ]
  }
}
